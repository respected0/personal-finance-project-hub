{
  "name": "@personal-finance-os/project-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:changed": "node scripts/verify-changed.mjs",
    "verify:doctor": "node scripts/verify-doctor.mjs",
    "manifest:check": "node scripts/check-manifest.mjs",
    "manifest:verify-refs": "node scripts/verify-manifest-refs.mjs",
    "boundaries:check": "node scripts/check-hub-boundaries.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "repo-map:check": "node scripts/check-repo-map.mjs",
    "version:check": "node scripts/check-releases.mjs",
    "release:check": "node scripts/check-releases.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "security:secret-scan": "node scripts/check-secrets.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:unit": "node --test tests/**/*.test.mjs",
    "check:all": "pnpm manifest:check && pnpm release:check && pnpm boundaries:check && pnpm docs:check && pnpm repo-map:check && pnpm security:secret-scan && pnpm test:unit",
    "check:ci": "pnpm check:all"
  },
  "devDependencies": {
    "yaml": "^2.7.0"
  },
  "packageManager": "pnpm@11.18.0"
}
